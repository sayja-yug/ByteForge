# ==========================================
# ByteForge - Render / Production Environment Variables
# ==========================================

# Secret Key (Generate a random key for production)
SECRET_KEY=django-insecure-ltv=s&yzzk4i^*v26$cjq%$j$(%+h^m*y$v^xj@-a3_9okvxfd

# Debug Mode (Set to False in production)
DEBUG=False

# Allowed Hosts (Comma-separated hostnames/domains)
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# CSRF Trusted Origins (Comma-separated HTTPS origins)
CSRF_TRUSTED_ORIGINS=https://byteforge.onrender.com

# Database Connection (Render PostgreSQL Connection String)
# Format: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://byteforge_user:password@dpg-xxxxxx-a.render.com/byteforge

# Python Version (Required on Render)
PYTHON_VERSION=3.11.8

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings
